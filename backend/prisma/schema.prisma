generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique @map("google_id")
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  watchlistPreferences WatchlistPreferences?
  watchlistCompanies   WatchlistCompany[]
  jobListings          UserJobListing[]
  applications         Application[]
  calendarConnection   CalendarConnection?
  calendarEventCategories CalendarEventCategory[]

  @@map("users")
}

// Tokens are encrypted by CalendarTokenCipher before reaching this table. Event
// data deliberately is not cached: Astir asks Google for only the next 30 days
// when the Home screen needs it, then returns the short-lived response.
model CalendarConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  accessTokenEncrypted  String?  @map("access_token_encrypted")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_connections")
}

// A category is the small amount of user-authored state Astir keeps about an
// otherwise on-demand Calendar event. Google event details remain uncached.
model CalendarEventCategory {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  calendarEventId String   @map("calendar_event_id")
  kind            String
  applicationId   String?  @map("application_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([userId, calendarEventId])
  @@index([applicationId])
  @@map("calendar_event_categories")
}

model WatchlistPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  keywords         String[] @default([])
  excludedKeywords String[] @default([]) @map("excluded_keywords")
  workModes        String[] @default([]) @map("work_modes")
  contractTypes    String[] @default([]) @map("contract_types")
  terms            String[] @default([])
  languages        String[] @default([])
  industryNoGos    String[] @default([]) @map("industry_no_gos")
  hiringRegions    String[] @default([]) @map("hiring_regions")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("watchlist_preferences")
}

// A board we poll for openings. There are two kinds (see JobBoardProvider):
//   kind "ats"        — one company per board; externalId is the provider
//                       handle (Greenhouse board token, Ashby job-board name,
//                       Workable subdomain). These rows are created on demand
//                       when a watchlist company resolves to a handle, and are
//                       shared across every user watching that company.
//   kind "aggregator" — a multi-company job board queried without a handle;
//                       externalId is a fixed feed key. (Future; see docs.)
// companyKey is the normalized company name used to dedupe ATS resolution so
// two users watching the same company share one source.
model JobSource {
  id            String    @id @default(cuid())
  provider      String
  kind          String    @default("ats")
  externalId    String    @map("external_id")
  companyName   String    @map("company_name")
  companyKey    String?   @map("company_key")
  enabled       Boolean   @default(true)
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastSyncError String?   @map("last_sync_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  listingSources     JobListingSource[]
  ingestionRuns     JobIngestionRun[]
  watchlistCompanies WatchlistCompany[]
  remoteCompanies    RemoteCompany[]

  @@unique([provider, externalId])
  @@index([companyKey])
  @@map("job_sources")
}

// One attempted pull of a source. These rows are append-only operational
// evidence: they make source reliability measurable over time without
// conflating a temporarily empty board with a failed request.
model JobIngestionRun {
  id                       String    @id @default(cuid())
  jobSourceId              String    @map("job_source_id")
  provider                 String
  startedAt                DateTime  @map("started_at")
  completedAt              DateTime  @map("completed_at")
  succeeded                Boolean
  fetchAttempts            Int       @default(1) @map("fetch_attempts")
  normalizedListingsSeen   Int       @default(0) @map("normalized_listings_seen")
  listingsCreated          Int       @default(0) @map("listings_created")
  existingListingsObserved Int       @default(0) @map("existing_listings_observed")
  staleObservationsSuppressed Int    @default(0) @map("stale_observations_suppressed")
  errorMessage             String?   @map("error_message")

  jobSource JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)

  @@index([jobSourceId, completedAt])
  @@index([provider, completedAt])
  @@map("job_ingestion_runs")
}

// A once-per-calendar-day view of corpus quality. The date, rather than a
// rolling timestamp, gives the internal quality page an honest daily trend.
model JobQualitySnapshot {
  id                            String   @id @default(cuid())
  observedOn                    DateTime @unique @map("observed_on")
  measuredAt                    DateTime @map("measured_at")
  canonicalListings             Int      @map("canonical_listings")
  sourceObservations            Int      @map("source_observations")
  listingsSeenWithin24Hours     Int      @map("listings_seen_within_24_hours")
  listingsWithPostedAt          Int      @map("listings_with_posted_at")
  medianListingAgeHours         Float?   @map("median_listing_age_hours")
  crossProviderCollisions       Int      @map("cross_provider_collisions")
  crossProviderExtraObservations Int     @map("cross_provider_extra_observations")
  listingsWithLocation          Int      @map("listings_with_location")
  listingsWithWorkMode          Int      @map("listings_with_work_mode")
  listingsWithDescription       Int      @map("listings_with_description")
  listingsWithContentLanguage   Int      @map("listings_with_content_language")

  @@map("job_quality_snapshots")
}

// A company on the global, admin-curated Remote Job Board list. Unlike a
// WatchlistCompany this is not owned by any user: it is one shared list that
// every user's Remote Job Board reads from. Each row resolves to a shared
// JobSource (same resolution path as the watchlist) which the ingestion cron
// then polls. resolutionStatus mirrors the watchlist: "resolved" (found on an
// ATS and being polled), "pending", or "unresolved" (not on any ATS).
model RemoteCompany {
  id                 String   @id @default(cuid())
  name               String
  nameKey            String   @unique @map("name_key")
  careersUrl         String?  @map("careers_url")
  companyWebsite     String?  @map("company_website")
  note               String?
  reviewed           Boolean  @default(false)
  reviewStatus       String   @default("not_reviewed") @map("review_status")
  remotePolicyStatus String   @default("clear") @map("remote_policy_status")
  jobSourceId        String?  @map("job_source_id")
  resolutionStatus   String   @default("pending") @map("resolution_status")
  addedByEmail       String?  @map("added_by_email")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  jobSource JobSource? @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)

  @@map("remote_companies")
}

// A company a user is watching. The union of all users' rows is the superset
// we resolve to ATS boards and poll. resolutionStatus tracks whether the
// company was found on an ATS ("resolved"), is still being looked up
// ("pending"), or was not found anywhere ("unresolved" — a scraping
// candidate; see docs/job-boards.md).
model WatchlistCompany {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  nameKey          String   @map("name_key")
  careersUrl       String?  @map("careers_url")
  alertsOn         Boolean  @default(true) @map("alerts_on")
  jobSourceId      String?  @map("job_source_id")
  resolutionStatus String   @default("pending") @map("resolution_status")
  // Where the user is in building referral contacts at this company, so a
  // posting can land on someone they already know. none: no outreach yet;
  // active: reaching out / conversations underway; warm: has a solid contact.
  networkingStage       String   @default("none") @map("networking_stage")
  networkingNotes       String?  @map("networking_notes")
  networkingConnections Json     @default("[]") @map("networking_connections")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobSource JobSource? @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)

  @@unique([userId, nameKey])
  @@map("watchlist_companies")
}

// One canonical opening. The same job posted through several providers is
// consolidated here via the fingerprint; the per-provider records live in
// JobListingSource.
model JobListing {
  id              String    @id @default(cuid())
  fingerprint     String    @unique
  title           String
  companyName     String    @map("company_name")
  location        String?
  locations       String[]  @default([])
  workMode        String?   @map("work_mode")
  descriptionText String?   @map("description_text")
  descriptionHash String?   @map("description_hash")
  // ISO 639-1 code of the language the ad is written in, when a provider
  // exposes it (Join, the schema.org JobPosting reader). A weak proxy for the
  // language a role expects; null when unknown.
  contentLanguage String?   @map("content_language")
  url             String
  postedAt        DateTime? @map("posted_at")
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sources      JobListingSource[]
  users        UserJobListing[]
  applications Application[]

  @@map("job_listings")
}

// Where a canonical listing was seen: one row per provider posting.
model JobListingSource {
  id          String   @id @default(cuid())
  listingId   String   @map("listing_id")
  jobSourceId String?  @map("job_source_id")
  provider    String
  externalId  String   @map("external_id")
  url         String
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  listing   JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  jobSource JobSource? @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@map("job_listing_sources")
}

// m:n between users and listings; a row means the listing matched the
// user's watchlist preferences and appears on their Job Boards screen.
model UserJobListing {
  userId          String   @map("user_id")
  listingId       String   @map("listing_id")
  status          String   @default("new")
  matchedKeywords String[] @default([]) @map("matched_keywords")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("user_job_listings")
}

// A job the user has applied to. Logged from the watchlist (or Job Boards),
// in which case listingId points at the canonical posting so we can show its
// location, work mode, and posted date; or entered by hand, in which case
// company/role/link stand alone. stageId is the fixed stage key used by app
// logic. status remains for compatibility with older rows and clients. note
// holds the client's rich-text block structure.
model Application {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  listingId      String?  @map("listing_id")
  company        String
  role           String
  link           String?
  status         String   @default("Applied")
  stageId        String   @default("applied") @map("stage_id")
  appliedDate    String   @map("applied_date")
  stageChangedAt DateTime @default(now()) @map("stage_changed_at")
  note           Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing JobListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  calendarEventCategories CalendarEventCategory[]

  @@index([userId])
  @@map("applications")
}
